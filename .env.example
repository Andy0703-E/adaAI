AI_BASE_URL=https://bandelbanget.xyz/v1
AI_API_KEY=
AI_DEFAULT_MODEL=deepseek-v4-flash
AI_MODELS_FALLBACK=hy3,kimi-k2.7-code,kimi-k2.7-code-highspeed,kimi-k3,mimo-v2.5-pro,minimax-m3,deepseek-v4-flash,deepseek-v4-flash-0731,deepseek-v4-flash-vision-exp,deepseek-v4-mod,deepseek-v4-pro,deepseek-v4-pro-0813,glm-5.1,glm-5.2,glm-5.3,glm-5.3-flash
AI_CHAT_PATH=/chat/completions
AI_MODELS_PATH=/models
AI_FIRST_BYTE_TIMEOUT_MS=30000
AI_STREAM_IDLE_TIMEOUT_MS=60000
AI_TOTAL_TIMEOUT_MS=300000
AI_MAX_OUTPUT_TOKENS=8192
# Supabase shared pooler (transaction mode) for application traffic.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DATABASE_PASSWORD>@aws-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase shared pooler (session mode) for Prisma migrations on IPv4 networks.
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DATABASE_PASSWORD>@aws-<REGION>.pooler.supabase.com:5432/postgres"
AUTH_SECRET=your-random-32-character-secret-key-here
REDIS_URL=redis://localhost:6379
NEXT_PUBLIC_APP_NAME=AdaAI
